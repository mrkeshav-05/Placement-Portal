generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  // Read-only: NOC requests (including the uploaded document) and placement
  // records, plus the analytics overview. No create/update/delete anywhere,
  // and never eligible to apply to a drive (see requireStudent in FastAPI).
  FACULTY
  PLACEMENT_VOLUNTEER
  PLACEMENT_TEAM
  SUPER_ADMIN
}

enum JobType {
  INTERNSHIP
  FTE
  INTERNSHIP_PPO
  INTERNSHIP_FTE
}

enum JobStatus {
  ACTIVE
  ENDED
  DRAFT
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
  /// Candidate confirmed they are taking the offer. Admin-only: students see
  /// this as SELECTED (see studentFacingStatus in the applications router).
  OFFER_ACCEPTED
  /// Candidate turned the offer down. Admin-only, same masking as above.
  OFFER_DECLINED
  WITHDRAWN
}

enum FeedbackType {
  QUERY
  FEEDBACK
  COMPLAINT
}

enum NocStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Whether the offer behind an NOC request came through a portal drive or the
/// student found it independently. Off-campus offers carry a supporting
/// document (see NocRequest.offCampusProofUrl) so the placement cell can
/// confirm the offer is real before proceeding.
enum NocSource {
  ON_CAMPUS
  OFF_CAMPUS
}

enum AnnouncementCategory {
  COMPANY_EVENT
  GENERAL
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
}

enum OfferType {
  /// Full-time placement offer.
  FTE
  /// Pre-placement offer converted from an internship.
  PPO
  /// Internship offer, paid as a monthly stipend.
  INTERNSHIP
}

enum OfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
  REVOKED
}

enum OfferSource {
  /// Recruited through a portal drive (or an on-campus process run outside
  /// the portal).
  ON_CAMPUS
  /// The student found and secured this offer independently.
  OFF_CAMPUS
  /// Won through a hackathon rather than a conventional interview process.
  /// Still counted as on-campus for reporting purposes.
  HACKATHON
}

enum InterviewExperienceStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                           String                @id @default(cuid())
  name                         String?
  email                        String?               @unique
  emailVerified                DateTime?
  image                        String?
  // bcrypt hash for institute-domain password sign-in. Null for accounts that
  // only use Google. Password sign-in is refused for non-STUDENT roles.
  passwordHash                 String?
  role                         Role                  @default(STUDENT)
  customPermissions            String[]              @default([])
  isActive                     Boolean               @default(true)
  title                        String?
  personalEmail                String?
  rollNumber                   String?               @unique
  branch                       String?
  batch                        Int?
  degree                       String?
  category                     String?
  gender                       String?
  dateOfBirth                  DateTime?
  bloodGroup                   String?
  contactNumber                String?
  altContactNumber             String?
  currentAddress               String?
  permanentAddress             String?
  aadhaarEncrypted             String?
  aadhaarDocUrl                String?
  aadhaarDocFileName           String?
  panCardEncrypted             String?
  panCardDocUrl                String?
  panCardDocFileName           String?
  // College ID card, stored exactly like Aadhaar and PAN: the card number is
  // encrypted at rest and doubles as the challenge that unlocks the scan.
  collegeIdEncrypted           String?
  collegeIdDocUrl              String?
  collegeIdDocFileName         String?
  class10Percent               Float?
  class12Percent               Float?
  semGPAs                      Float[]
  cgpa                         Float?
  cgpaBeforeDrop               Float?
  graduationGPA                Float?
  backlogs                     Int                   @default(0)
  bans                         Int                   @default(0)
  qrCodeData                   String?
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @default(now()) @updatedAt
  accounts                     Account[]
  sessions                     Session[]
  applications                 Application[]
  resumes                      Resume[]
  feedbacks                    Feedback[]
  nocRequests                  NocRequest[]
  notifications                Notification[]
  createdJobs                  JobProfile[]          @relation("JobCreator")
  createdAnnouncements         Announcement[]        @relation("AnnouncementCreator")
  offers                       Offer[]               @relation("OfferHolder")
  recordedOffers               Offer[]               @relation("OfferRecorder")
  interviewExperiences         InterviewExperience[] @relation("InterviewExperienceAuthor")
  reviewedInterviewExperiences InterviewExperience[] @relation("InterviewExperienceReviewer")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  /// Staged { name, passwordHash } for a pending registration-OTP claim —
  /// applied to `User` only once the code is verified, so the target row is
  /// never touched until mailbox ownership is proven. See the 2026-09-22
  /// decision. Unused for anything else this table might one day hold.
  payload    Json?

  @@id([identifier, token])
}

model Company {
  id            String         @id @default(cuid())
  name          String         @unique
  logoUrl       String?
  website       String?
  description   String?
  // How hard the drive is to clear, in the placement cell's own words: a
  // dream-round company may be applied to even after an offer is in hand.
  category      String?
  // Recruiting season the record was raised for. The same idea as
  // JobProfile.placementYear, under the label this screen uses.
  placementSession Int?
  // Quoted from the company as stated, so it stays free text rather than a
  // parsed figure with an invented currency and unit.
  turnover      String?
  createdAt     DateTime       @default(now())
  jobs          JobProfile[]
  announcements Announcement[]
  offers        Offer[]
}

model JobProfile {
  id                   String         @id @default(cuid())
  companyId            String
  title                String
  type                 JobType
  locations            String[]
  ctcStipend           Float?
  ctcStipendInfo       String?
  minCGPA              Float          @default(0)
  // Unset means no threshold, the same convention `minCGPA`'s own default of
  // 0 already carries. Optional eligibility criteria the event form's
  // "Enable Optional Eligibility Criteria" toggle reveals, alongside gender
  // and placement bans.
  min10Percent         Float?
  min12Percent         Float?
  maxBacklogs          Int            @default(0)
  maxBans              Int            @default(0)
  allowedBranches      String[]
  allowedDegrees       String[]
  allowedGenders       String[]
  jobCategory          String?
  batch                Int
  // Season the drive belongs to, which is not always the graduating batch it
  // is open to: a 2027-season internship recruits the 2028 batch.
  placementYear        Int
  registrationDeadline DateTime
  status               JobStatus      @default(DRAFT)
  description          String?
  openingOverview      String?
  // Policy and offer terms the placement cell writes as the company states
  // them, so they stay free text rather than a parsed figure.
  cap                  String?
  companyBond          String?
  duration             String?
  redirectUrl          String?
  // `{ fileName, fileUrl, mimeType, sizeBytes }[]`, the same shape
  // `AnnouncementAttachment` carries as columns — an inline JSON array
  // instead of a child table for the same reason `questions` is one: a
  // handful of files read and written together by the one form that owns
  // them, nothing queried per-file. Every row predates this column and was
  // always created with an empty array, so the type change carries no data.
  attachments          Json?
  // Extra questions the placement cell asks on top of the resume: each entry
  // is `{ id, type: "TEXT" | "MCQ" | "CHECKBOX" | "FILE", question, options? }`.
  // `options` only applies to MCQ/CHECKBOX. Nothing reads or writes a
  // student's answer yet — that needs its own column on `Application` and is
  // the deliberately separate next step.
  questions            Json?
  createdAt            DateTime       @default(now())
  createdById          String
  company              Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy            User           @relation("JobCreator", fields: [createdById], references: [id])
  applications         Application[]
  coordinators         Coordinator[]
  offers               Offer[]
  announcements        Announcement[]

  // The admin drives list and the student-facing "open opportunities" query
  // both filter on status (ACTIVE vs DRAFT/CLOSED) and order by deadline;
  // neither had an index to filter or sort with before this one.
  @@index([status])
  @@index([registrationDeadline])
}

model Application {
  id           String            @id @default(cuid())
  userId       String
  jobProfileId String
  resumeId     String?
  status       ApplicationStatus @default(APPLIED)
  appliedAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobProfile   JobProfile        @relation(fields: [jobProfileId], references: [id], onDelete: Cascade)
  resume       Resume?           @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  offer        Offer?

  // `@@unique([userId, jobProfileId])` already indexes that pair, but with
  // `userId` leading — no help to the admin list's `WHERE jobProfileId = ?`
  // or `WHERE status = ?`, which is exactly what it filters on.
  @@unique([userId, jobProfileId])
  @@index([jobProfileId])
  @@index([status])
}

model Announcement {
  id           String                   @id @default(cuid())
  title        String
  companyId    String?
  // The drive this announcement is about, when it is about one. The composer
  // narrows season -> company -> event, and this is where that choice lands,
  // so a shortlist notice can be traced to the opening it belongs to.
  jobProfileId String?
  content      String
  tags         String[]
  category     AnnouncementCategory
  // A DRAFT is visible only to the placement cell. Students see PUBLISHED rows
  // and nothing else, on every surface that lists announcements.
  status       AnnouncementStatus       @default(PUBLISHED)
  publishedAt  DateTime?
  createdAt    DateTime                 @default(now())
  createdById  String
  company      Company?                 @relation(fields: [companyId], references: [id], onDelete: SetNull)
  jobProfile   JobProfile?              @relation(fields: [jobProfileId], references: [id], onDelete: SetNull)
  createdBy    User                     @relation("AnnouncementCreator", fields: [createdById], references: [id])
  attachments  AnnouncementAttachment[]

  @@index([status])
}

/// A file published with an announcement: a shortlist, a schedule, a form. Kept
/// as rows rather than a URL array so the name and size a student sees come
/// from the upload itself instead of from parsing a storage URL.
model AnnouncementAttachment {
  id             String       @id @default(cuid())
  announcementId String
  fileName       String
  fileUrl        String
  mimeType       String
  sizeBytes      Int
  uploadedAt     DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
}

/// A recorded placement, pre-placement, or internship offer. This is the
/// placement record the office keeps: `Application` tracks a student through a
/// drive, while `Offer` is the outcome, and it exists even when the offer came
/// from somewhere the portal never ran a drive for. Package statistics are
/// aggregated from here and nowhere else.
model Offer {
  id            String      @id @default(cuid())
  userId        String
  companyId     String
  jobProfileId  String?
  applicationId String?     @unique
  type          OfferType
  status        OfferStatus @default(OFFERED)
  source        OfferSource @default(ON_CAMPUS)
  /// Role as the office records it. A drive's own title is the default, but an
  /// offer can be for a role the drive was not named after, and an offer with
  /// no drive behind it has no other place to keep one. Reads fall back to
  /// `jobProfile.title` so rows recorded before this column keep their role.
  jobTitle      String?
  /// Placement season, held as the graduating batch year.
  batch         Int
  /// Annual CTC in rupees. Required for FTE and PPO offers.
  ctc           Float?
  /// Monthly stipend in rupees. Required for internship offers.
  stipend       Float?
  location      String?
  offeredAt     DateTime    @default(now())
  /// When the student accepted or declined.
  decidedAt     DateTime?
  joiningDate   DateTime?
  remarks       String?
  createdAt     DateTime    @default(now())
  /// A DB-level default, not just Prisma's own `@updatedAt` bookkeeping: the
  /// backend writes this table directly with SQLAlchemy, which never sets
  /// this column itself, so a plain `@updatedAt` with no server-side default
  /// left it NULL on every insert (see SystemSetting.updatedAt for the same
  /// fix applied earlier).
  updatedAt     DateTime    @default(now()) @updatedAt
  createdById   String

  user        User         @relation("OfferHolder", fields: [userId], references: [id], onDelete: Cascade)
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobProfile  JobProfile?  @relation(fields: [jobProfileId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("OfferRecorder", fields: [createdById], references: [id])

  @@index([batch])
  @@index([userId])
  @@index([companyId])
}

model Feedback {
  id            String       @id @default(cuid())
  userId        String
  feedbackType  FeedbackType
  content       String
  resolved      Boolean      @default(false)
  adminResponse String?
  createdAt     DateTime     @default(now())
  resolvedAt    DateTime?
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NocRequest {
  id           String    @id @default(cuid())
  userId       String
  company      String
  address      String
  city         String
  state        String
  pincode      String
  startDate    DateTime
  endDate      DateTime
  status       NocStatus @default(PENDING)
  // The student's own remarks on the request. Only the student writes this.
  message      String?
  // The placement cell's remarks on the decision: the reason for a rejection,
  // or any condition attached to an approval. Kept separate from `message` so
  // a decision never overwrites what the student wrote.
  adminRemarks String?
  documentUrl  String?
  // Defaults ON_CAMPUS rather than being left unset, so every pre-existing row
  // (all recorded before this column existed) reads the same way they always
  // implicitly were: routed through a portal drive.
  source       NocSource @default(ON_CAMPUS)
  // The student's own proof of an off-campus offer (an offer letter or
  // equivalent), required by the form when source is OFF_CAMPUS. Separate
  // from `documentUrl`, which is the placement cell's signed NOC certificate
  // issued after a decision — this one is submitted by the student, before
  // any decision exists.
  offCampusProofUrl       String?
  // An independent marker, not a workflow gate: the placement cell can check
  // the uploaded proof and flip this whenever, but it is never required
  // before approving or rejecting the request.
  verifiedByPlacementTeam Boolean   @default(false)
  // False means the student is only recording an internship's company and
  // dates for the placement cell's records — no certificate is issued and no
  // approve/reject decision is made. `create_noc` sets `status` straight to
  // APPROVED for these rows since there is nothing left to decide; the UI
  // tells the two apart by this flag, not by status.
  nocRequired  Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InterviewExperience {
  id                      String                    @id @default(cuid())
  userId                  String
  companyName             String
  role                    String
  batch                   Int
  interviewType           String
  dsaQuestions            String?
  oopsQuestions           String?
  dbmsQuestions           String?
  osQuestions             String?
  cnQuestions             String?
  sqlQuestions            String?
  systemDesignQuestions   String?
  csFundamentalsQuestions String?
  resumeQuestions         String?
  projectsDiscussed       String?
  codingQuestions         String?
  aptitudeQuestions       String?
  hrQuestions             String?
  behavioralQuestions     String?
  resources               String?
  unansweredQuestions     String?
  tips                    String?
  status                  InterviewExperienceStatus @default(PENDING)
  reviewNote              String?
  reviewedById            String?
  reviewedAt              DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now()) @updatedAt
  user                    User                      @relation("InterviewExperienceAuthor", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy              User?                     @relation("InterviewExperienceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
}

model Resume {
  id           String        @id @default(cuid())
  userId       String
  label        String
  fileUrl      String
  fileName     String
  publicId     String?
  uploadedAt   DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
}

model Coordinator {
  id           String     @id @default(cuid())
  jobProfileId String
  name         String
  phone        String
  jobProfile   JobProfile @relation(fields: [jobProfileId], references: [id], onDelete: Cascade)
}

model TeamMember {
  id           String  @id @default(cuid())
  name         String
  role         String
  email        String?
  phone        String?
  photoUrl     String?
  displayOrder Int     @default(0)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}
