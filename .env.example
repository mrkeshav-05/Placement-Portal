# Copy to .env and fill in real values. Never commit .env.
# Docker Compose reads this file automatically from the repository root.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_DB="tnp_portal"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_PORT="5432"

# Used by host-side tooling (Prisma CLI, `npm run dev` outside Docker).
# Containers do not use this value; Compose builds their URL from POSTGRES_*
# and points it at the `db` service instead of localhost.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tnp_portal"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Sign-in is email and password only; there is no OAuth client to configure.

# Only addresses on this domain may register or sign in, apart from the
# ADMIN_EMAILS allowlist below.
STUDENT_EMAIL_DOMAIN="iiitl.ac.in"

# The ONLY source of administrator access: a comma-separated allowlist.
# There is no built-in administrator. Addresses listed here may sign in even
# from outside STUDENT_EMAIL_DOMAIN. Removing an address revokes ADMIN on the
# next request, and `npm run sync-admins` in database/ reconciles stored roles.
# Seeded administrator accounts start without a password: give the first one
# a password with `npm run db:set-password -- <email>`.
ADMIN_EMAILS=""

# ---------------------------------------------------------------------------
# Database table browser
# ---------------------------------------------------------------------------
# Password for the table browser at http://localhost:8000/admin, which reads
# and writes every column of every table around the portal's role
# permissions. Its own password, not a portal account: leaving it empty keeps
# the screen off, and anything under 16 characters is refused.
# Generate with: openssl rand -base64 24
DB_ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# Encryption
# ---------------------------------------------------------------------------
# AES-256-GCM key for Aadhaar/PAN. 64 hex characters (32 bytes).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Service wiring
# ---------------------------------------------------------------------------
ENVIRONMENT="development"
FRONTEND_PORT="3000"
BACKEND_PORT="8000"
CORS_ORIGINS="http://localhost:3000"

# Only needed when running the frontend outside Docker; Compose sets this to
# http://backend:8000 for the containerized stack.
BACKEND_URL="http://localhost:8000"

# ---------------------------------------------------------------------------
# External services (optional until the related features are enabled)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

RESEND_API_KEY=""
EMAIL_FROM="placements@iiitl.ac.in"
