# Copy to .env and fill in real values. Never commit .env.
# Docker Compose reads this file automatically from the repository root.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_DB="tnp_portal"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_PORT="5432"

# Used by host-side tooling (Prisma CLI, `npm run dev` outside Docker).
# Containers do not use this value; Compose builds their URL from POSTGRES_*
# and points it at the `db` service instead of localhost.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tnp_portal"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Sign-in is email and password only; there is no OAuth client to configure.

# Only addresses on this domain may register or sign in, apart from the
# ADMIN_EMAILS allowlist below.
STUDENT_EMAIL_DOMAIN="iiitl.ac.in"

# The ONLY source of administrator access: a comma-separated allowlist.
# There is no built-in administrator. Addresses listed here may sign in even
# from outside STUDENT_EMAIL_DOMAIN. Removing an address revokes ADMIN on the
# next request, and `npm run sync-admins` in database/ reconciles stored roles.
# Seeded administrator accounts start without a password: give the first one
# a password with `npm run db:set-password -- <email>`.
ADMIN_EMAILS=""

# ---------------------------------------------------------------------------
# Database table browser
# ---------------------------------------------------------------------------
# Password for the table browser at http://localhost:8000/admin, which reads
# and writes every column of every table around the portal's role
# permissions. Its own password, not a portal account: leaving it empty keeps
# the screen off, and anything under 16 characters is refused.
# Generate with: openssl rand -base64 24
DB_ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
# Redis, in front of the announcement and event reads. Optional in every
# sense: leave it empty and those endpoints query Postgres every time, which
# is also what happens when Redis is configured but unreachable. Nothing is
# stored here that cannot be rebuilt from one query, so losing it costs
# latency and nothing else.
#
# Used by host-side tooling only, the same way DATABASE_URL above is.
# Containers do not read this value: Compose points the backend and the
# frontend at the `cache` service directly, because localhost inside either
# container is itself.
REDIS_URL="redis://localhost:6379/0"
# Host port the cache is published on, for redis-cli and the like.
REDIS_PORT="6379"
# How long a cached list may be served before it is rebuilt. Writes clear it
# immediately, so this only bounds a change made outside the portal — through
# the table browser at /admin, or psql.
CACHE_TTL_SECONDS="300"

# ---------------------------------------------------------------------------
# Encryption
# ---------------------------------------------------------------------------
# AES-256-GCM key for Aadhaar/PAN. 64 hex characters (32 bytes).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Service wiring
# ---------------------------------------------------------------------------
ENVIRONMENT="development"
FRONTEND_PORT="3000"
BACKEND_PORT="8000"
CORS_ORIGINS="http://localhost:3000"

# Only needed when running the frontend outside Docker; Compose sets this to
# http://backend:8000 for the containerized stack.
BACKEND_URL="http://localhost:8000"

# ---------------------------------------------------------------------------
# External services (optional until the related features are enabled)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Leave empty for local/demo use: registration OTPs and other notification
# emails are then only logged to the backend console (see
# backend/app/services/email.py's is_email_delivery_configured), never
# delivered — this is why a "verification code sent" registration can still
# leave the inbox empty. For real delivery, set a real key from
# https://resend.com/api-keys AND verify a sending domain there that matches
# EMAIL_FROM's domain (an unverified domain makes Resend reject the send).
RESEND_API_KEY=""
EMAIL_FROM="placements@iiitl.ac.in"
